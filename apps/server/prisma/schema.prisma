generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum ConversationStatus {
  ACTIVE
  TRANSFERRED_TO_HUMAN
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum TicketStatus {
  PENDING
  PROCESSING
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum OperatorType {
  USER
  AGENT
  ADMIN
  AI
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  conversations Conversation[]
  tickets      Ticket[]
  ticketMessages TicketMessage[]
}

model Conversation {
  id        String             @id @default(uuid())
  userId    String
  status    ConversationStatus @default(ACTIVE)
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])
  messages  Message[]
  tickets   Ticket[]
  aiRuns    AiRun[]

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Ticket {
  id             String          @id @default(uuid())
  ticketNo       String          @unique
  userId         String
  conversationId String?
  category       String
  priority       TicketPriority  @default(MEDIUM)
  status         TicketStatus    @default(PENDING)
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  conversation   Conversation?   @relation(fields: [conversationId], references: [id])
  events         TicketEvent[]
  messages       TicketMessage[]

  @@index([userId, createdAt])
  @@index([status, priority, createdAt])
  @@index([category, status])
}

model TicketEvent {
  id           String       @id @default(uuid())
  ticketId     String
  eventType    String
  operatorType OperatorType
  operatorId   String?
  payload      Json?
  createdAt    DateTime     @default(now())
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketMessage {
  id           String       @id @default(uuid())
  ticketId     String
  authorId     String?
  authorType   OperatorType
  content      String
  createdAt    DateTime     @default(now())
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model AiRun {
  id             String       @id @default(uuid())
  conversationId String
  intent         String
  confidence     Decimal      @db.Decimal(3, 2)
  status         String
  latencyMs      Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls      ToolCallRecord[]

  @@index([conversationId, createdAt])
}

model ToolCallRecord {
  id        String   @id @default(uuid())
  aiRunId   String
  toolName  String
  input     Json?
  output    Json?
  status    String
  latencyMs Int      @default(0)
  createdAt DateTime @default(now())
  aiRun     AiRun    @relation(fields: [aiRunId], references: [id], onDelete: Cascade)

  @@index([aiRunId, createdAt])
}

model LoanApplication {
  id          String   @id @default(uuid())
  userId      String
  applicationNo String @unique
  amountCents Int
  status      String
  submittedAt DateTime
  updatedAt   DateTime @updatedAt

  @@index([userId, submittedAt])
}

model RepaymentRecord {
  id          String   @id @default(uuid())
  userId      String
  recordNo    String   @unique
  amountCents Int
  status      String
  failedReason String?
  dueDate     DateTime
  updatedAt   DateTime @updatedAt

  @@index([userId, dueDate])
}
