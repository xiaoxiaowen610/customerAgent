{
  "name": "finserve-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @finserve/shared-types build && concurrently -n server,web -c cyan,green \"pnpm --filter @finserve/server dev\" \"pnpm --filter @finserve/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @finserve/server test:integration",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @finserve/server prisma:generate",
    "db:migrate": "pnpm --filter @finserve/server prisma:migrate",
    "db:deploy": "pnpm --filter @finserve/server prisma:deploy",
    "db:seed": "pnpm --filter @finserve/server prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.5"
  }
}
